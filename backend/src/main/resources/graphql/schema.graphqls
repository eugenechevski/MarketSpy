type Query {
  getMarketData(id: ID!): MarketData
  getNewsFeed: [NewsFeed]
}

type MarketData {
  id: ID
  name: String
  price: Float
  timestamp: String
}

type NewsFeed {
  id: ID
  title: String
  url: String
  timePublished: String
  summary: String
  source: String
  category: String
  bannerImage: String
  sentimentScore: Float
  sentimentLabel: String
}

